### **`.env.example`**
# -----------------------------------------------------------------
# Ingestion Mode
# -----------------------------------------------------------------
# Set the data source for the 'ingest' service.
# Options: "mock", "confluence", "online"
INGEST_MODE=mock

# -----------------------------------------------------------------
# Confluence Configuration (if INGEST_MODE=confluence)
# -----------------------------------------------------------------
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
CONFLUENCE_USERNAME=service-account@company.com
CONFLUENCE_SPACES=ENGINEERING,HR,PRODUCT

# -----------------------------------------------------------------
# Online Scraper Configuration (if INGEST_MODE=online)
# -----------------------------------------------------------------
# Comma-separated list of URLs to scrape
ONLINE_DATASOURCES=https://en.wikipedia.org/wiki/Retrieval-augmented_generation

# -----------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------
# Qdrant Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=confluence_kb

# TGI (Text Generation Inference) Configuration
TGI_HOST=tgi
TGI_PORT=8080
TGI_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# -----------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.65
MAX_CONVERSATION_HISTORY=3

# -----------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------
ENABLE_PROMETHEUS=true
LOG_LEVEL=INFO